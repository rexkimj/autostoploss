# Bybit API Credentials
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Trading Settings
CHECK_INTERVAL=5  # 포지션 체크 간격 (초)
USE_TESTNET=true  # true: 테스트넷, false: 실거래

# Optional: Specific symbols to monitor (comma-separated)
# 설정하지 않으면 모든 포지션을 감시합니다
# 예시: WATCH_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# 또는: WATCH_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT
# WATCH_SYMBOLS=
